<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context="com.example.calculadora_senai.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- Logo central -->
        <ImageView
            android:layout_width="@dimen/logo_width"
            android:layout_height="@dimen/logo_height"
            android:src="@drawable/logo_senai"
            android:layout_gravity="center"
            android:contentDescription="Logo SENAI" />

        <!-- Titulo do App -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORION CALCULATOR"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:textColor="@color/display_text"
            android:layout_marginBottom="6dp"/>

        <!-- Display -->
        <TextView
            android:id="@+id/display"
            android:layout_width="match_parent"
            android:layout_height="@dimen/display_height"
            android:layout_marginBottom="4dp"
            android:text="0"
            android:textSize="@dimen/display_text_size"
            android:gravity="end|center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:padding="12dp"
            android:background="@drawable/display_background"
            android:textColor="@color/display_text"/>

        <!-- Linha 1: Memória -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="6">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mc"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MC"
                android:background="@drawable/button_memory"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mr"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MR"
                android:background="@drawable/button_memory"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_m_plus"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="M+"
                android:background="@drawable/button_memory"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_m_minus"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="M-"
                android:background="@drawable/button_memory"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_ms"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MS"
                android:background="@drawable/button_memory"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mv"
                style="@style/CalcButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MV"
                android:background="@drawable/button_memory"/>
        </LinearLayout>

    <!-- Linha 2: %, CE, C, Backspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_percent"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="%"
            android:background="@drawable/button_function"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_ce"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CE"
            android:background="@drawable/button_clear"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_c"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="C"
            android:background="@drawable/button_clear"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_backspace"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⌫"
            android:background="@drawable/button_backspace"/>
        </LinearLayout>

    <!-- Linha 3: 1/x, x², ³√x, ÷ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_reciprocal"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1/x"
            android:background="@drawable/button_function"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_square"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="x²"
            android:background="@drawable/button_function"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cube_root"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="³√x"
            android:background="@drawable/button_function"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_divide"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="÷"
            android:background="@drawable/button_operation"/>
        </LinearLayout>

    <!-- Linha 4: 7, 8, 9, x -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_7"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="7"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_8"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_9"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="9"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_multiply"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="x"
            android:background="@drawable/button_operation"/>
    </LinearLayout>

    <!-- Linha 5: 4, 5, 6, - -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_4"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_5"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_6"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="6"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_subtract"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-"
            android:background="@drawable/button_operation"/>
    </LinearLayout>

    <!-- Linha 6: 1, 2, 3, + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_1"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_2"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_3"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+"
            android:background="@drawable/button_operation"/>
    </LinearLayout>

    <!-- Linha 7: +/-, 0, ,, = -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="4">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_sign"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+/-"
            android:background="@drawable/button_function"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_0"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_decimal"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=","
            android:background="@drawable/button_number"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_equals"
            style="@style/CalcButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="="
            android:background="@drawable/button_equals"/>
    </LinearLayout>

    <!-- Rodapé -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROFESSOR: RICARDO MARCEL 2026"
        android:layout_gravity="center"
        android:textColor="@color/display_text"
        android:textSize="@dimen/footer_text_size"
        android:layout_marginTop="4dp"
        android:autoLink="web" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SENAI BLUMENAU&#10;SANTA CATARINA - BRASIL"
        android:layout_gravity="center"
        android:textColor="@color/display_text"
        android:textSize="@dimen/footer_text_size"
        android:autoLink="web" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="https://cursos.sesisenai.org.br/blumenau/"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center"
        android:layout_marginTop="2dp"
        android:textSize="@dimen/link_text_size"
        android:autoLink="web" />

    </LinearLayout>
</ScrollView>